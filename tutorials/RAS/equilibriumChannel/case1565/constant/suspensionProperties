FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      suspensionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * /

suspension         on;

MULESformulation   off;

diffusivity        turbulent;

fallModel
{
    type           fixedValue;
    value          0.016;
}

hindranceModel
{
    type           none;
}

wallDiffusivity
{
    alpha          5e-6;
}

CsbMax             0.3;

