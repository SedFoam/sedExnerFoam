FoamFile
{
    version     2.0;
    format      ascii;
    class       pointScalarField;
    object      pointDisplacementz;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    
    outlet
    {
        type            zeroGradient;
    }
    
    top
    {
        type            fixedValue;
        value           uniform 0;
    }

    bed
    {
        type            fixedValue;
        value           uniform 0;
    }

    sides
    {
        type            empty;
    }
}


