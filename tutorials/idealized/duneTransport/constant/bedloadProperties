FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      bedloadProperties;
}

// ************************** sediment properties ************************** //

sedimentBed            on;  // on or off

sedimentBedPatches     (bed);

bedloadModel
{
    type               none;
    alpha              0.05;
    beta               1.5;

    avalanche          on;
    Qav                3e-4;
}

